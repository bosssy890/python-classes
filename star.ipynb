    "import turtle\n",
    "turtle.Screen().bgcolor(\"purple\")\n",
    "turtle.Screen().setup(600,600)\n",
    "star =  turtle.Turtle()\n",
    "for i in range(5):\n",
    "    star.forward(200)\n",
    "    star.right(144)\n",
    "turtle.done()"
