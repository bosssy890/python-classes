   "source": [
    "sen = input (\"enter a sentence/word\")\n",
    "lett = input (\"enter which letter you want to count\")\n",
    "count = 0\n",
    "b = 0\n",
    "\n",
    "while b < len(sen):\n",
    "    if lett == sen [b]:\n",
    "        count = count +1\n",
    "    b = b +1\n",
    "print(count)\n"
   ]
